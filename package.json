{
  "name": "@data-fair/processing-france-parcelles-coords",
  "version": "0.1.3",
  "description": "Create the master-data dataset cadastre-parcelles-coords that links codes with coordinates from France's open-data.",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare": "husky || true",
    "build-types": "export NODE_OPTIONS='--experimental-strip-types' && df-build-types ./config && df-build-types ./types",
    "test-base": "NODE_ENV=test node --experimental-strip-types --test-force-exit --test-concurrency=1 --test --test-reporter=spec --test-reporter-destination=stdout",
    "test": "npm run test-base test-it/*.ts"
  },
  "imports": {
    "#config": "./lib/config.ts",
    "#types/*": "./types/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/data-fair/processing-france-parcelles-coords.git"
  },
  "keywords": [
    "data-fair-processings-plugin"
  ],
  "author": "Alban Mouton <alban.mouton@gmail.com>",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/data-fair/processing-france-parcelles-coords/issues"
  },
  "homepage": "https://github.com/data-fair/processing-france-parcelles-coords#readme",
  "dependencies": {
    "@turf/point-on-feature": "^7.4.0",
    "fs-extra": "^11.4.0",
    "JSONStream": "^1.3.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@data-fair/lib-common-types": "^1.22.0",
    "@data-fair/lib-processing-dev": "^0.3.0",
    "@data-fair/lib-types-builder": "^1.14.3",
    "@data-fair/lib-utils": "^1.13.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.4.0",
    "axios": "^1.20.0",
    "config": "^5.0.1",
    "debug": "^4.4.3",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "neostandard": "^0.13.0",
    "typescript": "^5.9.3",
    "ws": "^8.21.3"
  },
  "files": [
    "processing-config-schema.json",
    "./lib/**/*"
  ]
}
